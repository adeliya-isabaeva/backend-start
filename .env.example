# Шаблон .env — реальные секреты не коммитить!

API_KEY=change_me
DB_HOST=db
DB_PORT=5432
DB_NAME=shop_db
DB_USER=shop_user
DB_PASSWORD=change_me

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# Эту строку тоже делаем с заглушкой:
DATABASE_URL=postgresql://shop_user:change_me@shop-db:5432/shop_db
